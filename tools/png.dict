ihdr="IHDR"
idat="IDAT"
iend="IEND"
plte="PLTE"
trns="tRNS"
gama="gAMA"
chrm="cHRM"
srgb="sRGB"
sbit="sBIT"
bkgd="bKGD"
phys="pHYs"
time="tIME"
hist="hIST"
iccp="iCCP"
text="tEXt"
ztxt="zTXt"
itxt="iTXt"
splt="sPLT"
exif="eXIf"
ihdr_length="\x00\x00\x00\x0d"
iend_chunk="\x00\x00\x00\x00IEND\xae\x42\x60\x82"
zlib_fast="\x78\x01"
